# Optional settings for `docker compose --env-file deploy/.env ...`.
# Paths are relative to the repository root; use an absolute path outside it
# when storing production secrets.
KRINE_SECRETS_DIR=./deploy/secrets
KRINE_POSTGRES_PORT=15432
KRINE_VALKEY_PORT=16379
KRINE_CLICKHOUSE_PORT=18123

# Complete application deployment. Copy this file to .env and replace both
# origins before running ./scripts/up.sh. The dashboard shares the API origin.
KRINE_PUBLIC_URL=https://trust.example.com
KRINE_ALLOWED_ORIGINS=https://app.example.com
KRINE_HTTP_PORT=8080
KRINE_DEVELOPMENT=false
# Only the actual reverse proxy addresses, never arbitrary client networks.
KRINE_TRUSTED_PROXIES=
