# Shared local HTTP ingress. Override both ports without changing container ports.
KRINE_HTTP_PORT=8080
KRINE_EXAMPLE_PORT=3000
KRINE_PUBLIC_URL=http://127.0.0.1:${KRINE_HTTP_PORT}
KRINE_ALLOWED_ORIGINS=http://localhost:${KRINE_EXAMPLE_PORT}
KRINE_DEVELOPMENT=true
# First three octets of an unused private /24. The ingress uses .2; dynamic
# container addresses come from .128/25 so they cannot claim the trusted IP.
KRINE_EXAMPLE_NETWORK_PREFIX=10.203.80
