# Native development only: run both applications on the same loopback ingress.
DEMO_DEVELOPMENT=true
DEMO_ORIGIN=http://localhost:3000
DEMO_PORT=3000
DEMO_DATA_DIR=.data
KRINE_URL=http://127.0.0.1:8080
# Optional separate browser-visible origin; defaults to KRINE_URL.
# KRINE_BROWSER_URL=https://trust.example.com
KRINE_PUBLIC_KEY_FILE=../../deploy/secrets/browser_public_key
KRINE_SECRET_KEY_FILE=../../deploy/secrets/server_secret
# Only initial evaluations use this local application policy.
KRINE_FALLBACK=ALLOW
